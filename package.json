{
  "name": "mineradio",
  "productName": "Mineradio Next",
  "version": "2.2.0",
  "description": "Windows 沉浸式音乐播放器，融合桌面模式、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "Mineradio-Next",
  "license": "GPL-3.0-only",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node scripts/quick-check.js --full",
    "check:ci": "node scripts/quick-check.js",
    "security:audit": "npm audit --audit-level=high",
    "upstream:report": "node scripts/upstream-report.js",
    "maintenance:check": "node scripts/maintenance-check.js",
    "brand:assets": "node scripts/generate-brand-assets.js",
    "release:verify": "node scripts/verify-release-readiness.js",
    "release:checksums": "node scripts/create-release-checksums.js",
    "qa:update-ui": "node scripts/check-update-ui-live.js",
    "qa:update-ui:review": "node scripts/check-update-ui-live.js --review",
    "build:win": "electron-builder --win nsis --publish never",
    "build:win:dir": "electron-builder --win dir",
    "build:win:internal-beta": "electron-builder --config electron-builder.internal-beta.json --win nsis --publish never"
  },
  "build": {
    "appId": "com.mineradio.next",
    "productName": "Mineradio Next",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "cuefield/**/*",
      "server.js",
      "source-host.js",
      "backup-catalog-search.js",
      "platform-playlist-link-import.js",
      "platform-rankings.js",
      "*-api.js",
      "qishui-auth-v6.js",
      "qishui-qr-login.js",
      "qishui-auth-v6/**/*",
      "qishui-audio-decryptor/**/*",
      "dj-analyzer.js",
      "LICENSE",
      "NOTICE.md",
      "docs/THIRD_PARTY_PORTS.md",
      "package.json",
      "!desktop/wallpaper-preload.js",
      "!public/wallpaper.html",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": true,
    "win": {
      "executableName": "Mineradio-Next",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Mineradio Next",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "Mineradio-Next-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mineradio-Next",
        "repo": "Mineradio-Next"
      }
    ]
  },
  "mineradio": {
    "dataDirectoryName": "Mineradio",
    "appUserModelId": "com.mineradio.next",
    "update": {
      "provider": "github",
      "owner": "Mineradio-Next",
      "repo": "Mineradio-Next",
      "preview": false
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "music-metadata": "11.14.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "axios": "1.18.1",
    "body-parser": "1.20.6",
    "music-metadata": "11.14.0"
  },
  "devDependencies": {
    "electron": "^42.9.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2"
  }
}
